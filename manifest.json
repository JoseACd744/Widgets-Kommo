        "/images/slideshow_3_en.png"
      ],
      "es": [
        "/images/slideshow_1_es.png",
        "/images/slideshow_2_es.png",
        "/images/slideshow_3_es.png"
      ]
    },
    "tour_description": "widget.tour_description"
