# Copiar a .env para desarrollo local (en Railway se cargan como Variables).

KOMMO_SUBDOMAIN=holos

# Pestaña "Claves y scopes" de la integración privada en Kommo.
KOMMO_CLIENT_ID=
KOMMO_CLIENT_SECRET=

# Debe coincidir EXACTAMENTE con el enlace de redirección registrado en Kommo.
KOMMO_REDIRECT_URI=https://server-widget-chats-production.up.railway.app/oauth/callback

# Inventala; la misma va en los ajustes del widget.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WIDGET_KEY=

# Orígenes que reciben cabeceras CORS, separados por coma.
ALLOWED_ORIGINS=https://holos.kommo.com

# Ruta del volumen persistente. En Railway: /data
DATA_DIR=./data
